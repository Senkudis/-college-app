# ===== MongoDB =====
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/?appName=Cluster0

# ===== JWT =====
JWT_SECRET=your-secret-key-change-in-production
# مطلوب لتجديد الـ access tokens — يجب أن يكون مختلفاً عن JWT_SECRET
REFRESH_SECRET=your-refresh-secret-key-change-in-production

# ===== Server =====
PORT=5000

# Comma-separated browser origins allowed to call the API in production.
# Same-origin web requests and native mobile requests do not need this.
# اختياري: أصول إضافية مسموح بها، مفصولة بفواصل.
# نطاق التطبيق وأصول Capacitor مسموح بها تلقائياً في server.js،
# فلا حاجة لضبط هذا المتغير إلا عند إضافة نطاق آخر.
CORS_ORIGIN=

# ===== SMTP (Email - cPanel SSL) =====
SMTP_HOST=elnasrcsit.website
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=help@elnasrcsit.website
SMTP_PASS=your-smtp-password
SMTP_FROM="كلية تقنية المعلومات <help@elnasrcsit.website>"

# ===== Web Push VAPID =====
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# ===== Gemini AI — Study Assistant =====
# أضف حتى 5 مفاتيح مجانية — النظام يتحول تلقائياً عند وصول أي منها لحده
# احصل على مفاتيح مجانية من: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...key1
GEMINI_API_KEY_2=AIza...key2
GEMINI_API_KEY_3=AIza...key3
# GEMINI_API_KEY_4=AIza...key4  (اختياري)
# GEMINI_API_KEY_5=AIza...key5  (اختياري)

# الخطط الاحتياطية للمساعد عند فشل Gemini (بالترتيب)
COHERE_API_KEY=
# مفاتيح Cohere احتياطية بالأولوية (اختيارية)
COHERE_API_KEY_2=
COHERE_API_KEY_3=
GROQ_API_KEY=
# مفاتيح Groq إضافية للتناوب ومضاعفة الحصة اليومية (اختيارية)
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ===== Qwen (Alibaba Cloud Model Studio) =====
# نافذة سياق واسعة — يُستدعى أولاً في سلسلة الاحتياط بعد Gemini،
# وهو الأنسب لطلبات "لخّص المادة كاملة" حيث يبلغ السياق ٦٠ ألف حرف.
# احصل على المفتاح من: modelstudio.console.alibabacloud.com ← API Key
QWEN_API_KEY=
QWEN_API_KEY_2=
QWEN_API_KEY_3=
# نموذج qwen-plus افتراضياً (بدائل: qwen-max للجودة، qwen-turbo للسرعة)
QWEN_MODEL=qwen-plus
# نطاق مساحة العمل المخصّص من صفحة API Key (بلا https:// وبلا مسار).
# اتركه فارغاً لاستخدام النطاق العام dashscope-intl.aliyuncs.com
QWEN_API_HOST=
QWEN_API_PATH=/compatible-mode/v1/chat/completions
