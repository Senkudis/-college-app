# ===== MongoDB =====
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/?appName=Cluster0

# ===== JWT =====
JWT_SECRET=your-secret-key-change-in-production
# مطلوب لتجديد الـ access tokens — يجب أن يكون مختلفاً عن JWT_SECRET
REFRESH_SECRET=your-refresh-secret-key-change-in-production

# ===== Server =====
PORT=5000

# Comma-separated browser origins allowed to call the API in production.
# Same-origin web requests and native mobile requests do not need this.
# اختياري: أصول إضافية مسموح بها، مفصولة بفواصل.
# نطاق التطبيق وأصول Capacitor مسموح بها تلقائياً في server.js،
# فلا حاجة لضبط هذا المتغير إلا عند إضافة نطاق آخر.
CORS_ORIGIN=

# ===== SMTP (Email - cPanel SSL) =====
SMTP_HOST=elnasrcsit.website
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=help@elnasrcsit.website
SMTP_PASS=your-smtp-password
SMTP_FROM="كلية تقنية المعلومات <help@elnasrcsit.website>"

# ===== Web Push VAPID =====
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# ===== مساعد كيدي — ترتيب المزوّدين =====
# يُجرَّب المزوّدون بهذا الترتيب، ويُتخطى من لا مفتاح له ومن لا يتسع للطلب
# (Groq المجاني لا يقبل طلب "لخّص المادة" فيذهب تلقائياً لـ Z.AI). الافتراضي:
AI_PROVIDER_ORDER=groq,nvidia,zai,cohere,gemini,radox,mistral,qwen

# ===== Radox AI — وسيط، احتياطي أخير فقط =====
# 10 ملايين توكن شهرياً مجاناً. يمرّر الطلبات لمزوّدين آخرين ولا يذكر جهته،
# فاتركه آخر الترتيب كي لا يصله سياق الطلاب إلا عند فشل الجميع.
RADOX_API_KEY=
RADOX_MODEL=deepseek-v4-pro-max

# ===== NVIDIA NIM — الأسرع للطلبات الطويلة =====
# ~40 طلباً في الدقيقة لكل نموذج، مجاني للتجربة، بلا بطاقة.
# احصل على المفتاح (nvapi-...) من: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ===== Z.AI (GLM) — مجاني، الأنسب للطلبات الطويلة =====
# شركة صينية: يعمل التسجيل من السودان (NVIDIA وMistral لم يعملا).
# glm-4.5-flash مجاني بسياق 128 ألف توكن؛ حدّه طلب واحد متزامن.
# لا تستخدم glm-5.3-flash/flashx — مدفوعان.
# احصل على المفتاح من: https://z.ai ← API Keys
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash

# ===== Mistral (خطة Experiment المجانية) — المزوّد الأساسي =====
# ~مليار توكن شهرياً، سياق 128 ألف توكن، بلا بطاقة (يتطلب رقم هاتف).
# تنبيه: طلبات الخطة المجانية قد تُستخدم في تدريب نماذج Mistral.
# احصل على المفتاح من: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_MODEL=mistral-small-latest

# ===== Gemini AI — Study Assistant =====
# أضف حتى 5 مفاتيح — النظام يتحول تلقائياً عند وصول أي منها لحده.
# للمجانية: أنشئ المفتاح في مشروع جديد بلا فوترة؛ مفاتيح المشاريع ذات
# الدفع المسبق تتوقف عند نفاد الرصيد (402 "prepayment credits are depleted").
# احصل على مفاتيح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...key1
GEMINI_API_KEY_2=AIza...key2
GEMINI_API_KEY_3=AIza...key3
# GEMINI_API_KEY_4=AIza...key4  (اختياري)
# GEMINI_API_KEY_5=AIza...key5  (اختياري)

# الخطط الاحتياطية للمساعد عند فشل Gemini (بالترتيب)
COHERE_API_KEY=
# مفاتيح Cohere احتياطية بالأولوية (اختيارية)
COHERE_API_KEY_2=
COHERE_API_KEY_3=
GROQ_API_KEY=
# مفاتيح Groq إضافية للتناوب ومضاعفة الحصة اليومية (اختيارية)
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# حد حجم الطلب (مدخلات + مخرجات بالتوكن) في خطة Groq — 8000 في المجانية
GROQ_MAX_REQUEST_TOKENS=8000

# ===== Qwen (Alibaba Cloud Model Studio) =====
# نافذة سياق واسعة — يُستدعى أولاً في سلسلة الاحتياط بعد Gemini،
# وهو الأنسب لطلبات "لخّص المادة كاملة" حيث يبلغ السياق ٦٠ ألف حرف.
# احصل على المفتاح من: modelstudio.console.alibabacloud.com ← API Key
QWEN_API_KEY=
QWEN_API_KEY_2=
QWEN_API_KEY_3=
# نموذج qwen-plus افتراضياً (بدائل: qwen-max للجودة، qwen-turbo للسرعة)
QWEN_MODEL=qwen-plus
# نطاق مساحة العمل المخصّص من صفحة API Key (بلا https:// وبلا مسار).
# اتركه فارغاً لاستخدام النطاق العام dashscope-intl.aliyuncs.com
QWEN_API_HOST=
QWEN_API_PATH=/compatible-mode/v1/chat/completions
